# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Gmail SMTP - Go to myaccount.google.com -> Security -> App Passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where contact form emails will be sent
CONTACT_RECIPIENT=sales@comeetindia.com

# -------------------------------------------------------------------------
# Neon (PostgreSQL) Database — required for the Admin CMS
# -------------------------------------------------------------------------
# 1. Create a free account at https://neon.tech
# 2. Create a new project (free tier is sufficient)
# 3. Copy the connection string from the Neon dashboard
#    Format: postgresql://user:password@host/dbname?sslmode=require
# 4. Paste it below as DATABASE_URL
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------------------------------------
# Admin CMS Password
# -------------------------------------------------------------------------
# The password used to log in at /admin
# Change this to a strong password before deploying to production!
ADMIN_PASSWORD=comeet@admin2024

# -------------------------------------------------------------------------
# Base URL (required for server-side fetch in about/quality pages)
# -------------------------------------------------------------------------
# In development: http://localhost:3000
# In production: https://your-vercel-domain.vercel.app (or custom domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
